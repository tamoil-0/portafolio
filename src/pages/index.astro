---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectMedia from '../components/ProjectMedia.astro';
import { CATEGORIES, categoriesOf, fmtPeriod, profile, projects, projectUrl, teamLabel, techsOf, url } from '../lib/site';

const featured = projects.filter((p) => p.featured);
const countOf = (key: string) => projects.filter((p) => categoriesOf(p).includes(key as never)).length;
const categories = CATEGORIES.filter((c) => countOf(c.key) > 0);
const catStats = categories.map((c) => ({ ...c, n: countOf(c.key) })).sort((a, b) => b.n - a.n);
const catMax = Math.max(...catStats.map((c) => c.n));
const techCount = new Map<string, number>();
projects.forEach((p) => techsOf(p).forEach((t) => techCount.set(t, (techCount.get(t) ?? 0) + 1)));
const techStats = [...techCount].map(([name, n]) => ({ name, n })).sort((a, b) => b.n - a.n || a.name.localeCompare(b.name)).slice(0, 10);
const techMax = Math.max(...techStats.map((t) => t.n));

const bySlug = new Map(projects.map((p) => [p.slug, p]));
const linkFor = (slug?: string) => (slug && bySlug.has(slug) ? projectUrl(bySlug.get(slug)!) : null);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  alternateName: profile.shortName,
  jobTitle: profile.role,
  email: `mailto:${profile.email}`,
  image: profile.photo ? new URL(url(profile.photo.src), Astro.site).href : undefined,
  address: { '@type': 'PostalAddress', addressLocality: 'Puno', addressCountry: 'PE' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: profile.education.school },
  url: new URL(url(), Astro.site).href,
  sameAs: [profile.links.github, profile.links.linkedin],
  knowsAbout: profile.skills.flatMap((s) => s.items).slice(0, 20),
  knowsLanguage: profile.languages.map((l) => l.name),
};
---
<Base description={`${profile.shortName}: ${profile.tagline}`} jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="hero container">
    <p class="eyebrow">Portafolio · {profile.location}</p>
    <h1 class="hero-title display">{profile.name}</h1>
    <p class="hero-role">{profile.role}</p>
    <p class="lead hero-tagline">{profile.tagline}</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="#proyectos">Ver proyectos <Icon name="arrowDown" size={16} /></a>
      <a class="btn btn-secondary" href="#contacto">Contactar</a>
      <span class="hero-links">
        <a class="btn btn-ghost" href={profile.links.github} target="_blank" rel="me noopener"><Icon name="github" size={16} /> GitHub</a>
        <a class="btn btn-ghost" href={profile.links.linkedin} target="_blank" rel="me noopener"><Icon name="linkedin" size={16} /> LinkedIn</a>
      </span>
    </div>
    <dl class="hero-stats">
      <div><dt>Proyectos</dt><dd>{projects.length}</dd></div>
      <div><dt>En equipo</dt><dd>{projects.filter((p) => (p.teamSize ?? 1) > 1).length}</dd></div>
      <div><dt>Con IA</dt><dd>{projects.filter((p) => p.ai).length}</dd></div>
      <div><dt>Experiencia desde</dt><dd>2024</dd></div>
    </dl>
  </section>

  <!-- Destacados -->
  <section class="section" id="proyectos" aria-labelledby="destacados-title">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">Selección</p>
        <h2 id="destacados-title" class="h2 display">Proyectos destacados</h2>
        <p class="lead">Lo que mejor muestra cómo trabajo: problemas reales, de punta a punta.</p>
      </header>
      <div class="featured">
        {featured.map((p, i) => (
          <article class:list={['feat reveal', i % 2 === 1 && 'is-alt']}>
            <a class="feat-media" href={projectUrl(p)} tabindex="-1" aria-hidden="true">
              <ProjectMedia project={p} eager={i === 0} sizes="(min-width: 1024px) 640px, 100vw" />
            </a>
            <div class="feat-body">
              <p class="feat-meta">
                <span class="badge badge-accent">{p.category}</span>
                <span class="muted">{fmtPeriod(p.period)} · {teamLabel(p.teamSize)}</span>
              </p>
              <h3 class="feat-title display"><a href={projectUrl(p)}>{p.title}</a></h3>
              <p class="muted">{p.shortDescription}</p>
              <ul class="badges" aria-label="Tecnologías">{p.stack.slice(0, 6).map((s) => <li class="badge">{s}</li>)}</ul>
              <div class="feat-actions">
                <a class="btn btn-primary" href={projectUrl(p)}>Ver proyecto <Icon name="arrowRight" size={16} /></a>
                {p.liveUrl && <a class="btn btn-secondary" href={p.liveUrl} target="_blank" rel="noopener">Ver página <Icon name="external" size={16} /></a>}
                {p.isPrivate && <span class="badge"><Icon name="lock" size={12} /> Privado</span>}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Todos -->
  <section class="section" id="todos" aria-labelledby="todos-title">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">Archivo</p>
        <h2 id="todos-title" class="h2 display">Todos los proyectos</h2>
        <p class="lead">Haz clic en una barra para filtrar, o combina los filtros de abajo.</p>
      </header>

      <div class="charts">
        <figure class="chart reveal" aria-labelledby="ch-cat-t">
          <figcaption id="ch-cat-t" class="chart-title">Proyectos por categoría</figcaption>
          <ul class="bars">
            {catStats.map((c) => (
              <li>
                <button type="button" class="bar-row" data-chart-cat={c.key} data-tip={`${c.n} proyectos · ${c.label}`} aria-label={`${c.label}: ${c.n} proyectos. Filtrar`}>
                  <span class="bar-label">{c.label}</span>
                  <span class="bar-track"><span class="bar-fill" style={`--w:${(c.n / catMax) * 100}%`} /></span>
                  <span class="bar-value">{c.n}</span>
                </button>
              </li>
            ))}
          </ul>
        </figure>
        <figure class="chart reveal" aria-labelledby="ch-tech-t">
          <figcaption id="ch-tech-t" class="chart-title">Tecnologías más usadas <span class="muted">· nº de proyectos</span></figcaption>
          <ul class="bars">
            {techStats.map((t) => (
              <li>
                <button type="button" class="bar-row" data-chart-tech={t.name} data-tip={`${t.n} proyectos usan ${t.name}`} aria-label={`${t.name}: ${t.n} proyectos. Filtrar`}>
                  <span class="bar-label">{t.name}</span>
                  <span class="bar-track"><span class="bar-fill" style={`--w:${(t.n / techMax) * 100}%`} /></span>
                  <span class="bar-value">{t.n}</span>
                </button>
              </li>
            ))}
          </ul>
        </figure>
        <div class="chart-tip" role="status" aria-hidden="true" data-chart-tip></div>
      </div>

      <div class="filters" role="toolbar" aria-label="Filtrar proyectos">
        <div class="chips">
          <button type="button" class="chip" aria-pressed="true" data-filter="all">Todos <span>{projects.length}</span></button>
          {categories.map((c) => (
            <button type="button" class="chip" aria-pressed="false" data-filter={c.key}>
              {c.label} <span>{countOf(c.key)}</span>
            </button>
          ))}
        </div>
        <label class="search">
          <Icon name="search" size={16} />
          <span class="sr-only">Buscar por tecnología o nombre</span>
          <input type="search" placeholder="Buscar: Flutter, Python, IA…" data-search-input autocomplete="off" />
        </label>
      </div>
      <div class="filters-2">
        <div class="chips" aria-label="Filtros adicionales">
          <button type="button" class="chip chip-sm" aria-pressed="false" data-toggle="live"><Icon name="external" size={14} /> Con página en vivo <span>{projects.filter((p) => p.liveUrl).length}</span></button>
          <button type="button" class="chip chip-sm" aria-pressed="false" data-toggle="private"><Icon name="lock" size={14} /> Privados <span>{projects.filter((p) => p.isPrivate).length}</span></button>
          <button type="button" class="chip chip-sm" aria-pressed="false" data-toggle="team"><Icon name="users" size={14} /> En equipo <span>{projects.filter((p) => (p.teamSize ?? 1) > 1).length}</span></button>
          <span class="chip chip-sm chip-tech" data-tech-chip hidden>
            <span data-tech-name></span>
            <button type="button" class="chip-x" data-tech-clear aria-label="Quitar filtro de tecnología"><Icon name="close" size={14} /></button>
          </span>
        </div>
        <label class="sort">
          <span class="muted">Ordenar</span>
          <select data-sort>
            <option value="order">Relevancia</option>
            <option value="recent">Más recientes</option>
          </select>
        </label>
      </div>
      <p class="results muted" aria-live="polite" data-results-count>{projects.length} proyectos</p>
      <div class="grid" data-grid>
        {projects.map((p) => <ProjectCard project={p} />)}
      </div>
      <div class="empty" data-empty hidden>
        <p class="muted">No hay proyectos con esos filtros.</p>
        <button type="button" class="btn btn-secondary" data-reset>Quitar filtros</button>
      </div>
    </div>
  </section>

  <!-- Sobre mí -->
  <section class="section" id="sobre-mi" aria-labelledby="sobre-title">
    <div class="container grid-12">
      <header class="about-head">
        <p class="eyebrow">Sobre mí</p>
        <h2 id="sobre-title" class="h2 display">Software que se usa.</h2>
        {profile.photo && (
          <img
            class="about-photo"
            src={url(profile.photo.src)}
            alt={profile.photo.alt}
            width={profile.photo.width}
            height={profile.photo.height}
            loading="lazy"
            decoding="async"
          />
        )}
      </header>
      <div class="about-body reveal">
        {profile.bio.map((b) => <p>{b}</p>)}
        <h3 class="about-sub">Me interesa</h3>
        <ul class="about-list">{profile.interests.map((i) => <li>{i}</li>)}</ul>
        <h3 class="about-sub">Lo que busco</h3>
        <p>{profile.lookingFor}</p>
      </div>
    </div>
  </section>

  <!-- Stack -->
  <section class="section" id="stack" aria-labelledby="stack-title">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">Herramientas</p>
        <h2 id="stack-title" class="h2 display">Stack y habilidades</h2>
      </header>
      <div class="skills">
        {profile.skills.map((s) => (
          <div class="skill-group reveal">
            <h3>{s.group}</h3>
            <ul class="badges">{s.items.map((i) => <li class="badge">{i}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Trayectoria -->
  <section class="section" id="trayectoria" aria-labelledby="tray-title">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">Trayectoria</p>
        <h2 id="tray-title" class="h2 display">Experiencia y formación</h2>
      </header>
      <div class="tray">
        <div>
          <h3 class="tray-h">Experiencia</h3>
          <ol class="timeline">
            {profile.experience.map((e) => {
              const href = linkFor(e.project);
              return (
                <li class="tl-item reveal">
                  <p class="tl-period muted">{e.period} · {e.place}</p>
                  <h4 class="tl-role">{e.role}</h4>
                  <p class="tl-org">{href ? <a href={href}>{e.org}</a> : e.org}</p>
                  <p class="tl-sum muted">{e.summary}</p>
                </li>
              );
            })}
          </ol>
        </div>
        <div class="tray-side">
          <div class="tray-block reveal">
            <h3 class="tray-h">Formación</h3>
            <p class="tl-period muted">{profile.education.period} · {profile.education.place}</p>
            <h4 class="tl-role">{profile.education.school}</h4>
            <p class="tl-org">{profile.education.degree}</p>
            <ul class="dash-list muted">{profile.education.highlights.map((h) => <li>{h}</li>)}</ul>
          </div>
          <div class="tray-block reveal">
            <h3 class="tray-h">Reconocimientos</h3>
            <ul class="awards">
              {profile.achievements.map((a) => {
                const href = linkFor(a.project);
                return (
                  <li>
                    <strong>{href ? <a href={href}>{a.title}</a> : a.title}</strong>
                    <span class="muted">{a.detail}</span>
                  </li>
                );
              })}
            </ul>
          </div>
          <div class="tray-block reveal">
            <h3 class="tray-h">Formación complementaria</h3>
            <ul class="dash-list muted">{profile.training.map((t) => <li>{t}</li>)}</ul>
          </div>
          <div class="tray-block reveal">
            <h3 class="tray-h">Idiomas</h3>
            <ul class="badges">{profile.languages.map((l) => <li class="badge">{l.name} · {l.level}</li>)}</ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contacto -->
  <section class="section contact" id="contacto" aria-labelledby="contacto-title">
    <div class="container">
      <p class="eyebrow">Contacto</p>
      <h2 id="contacto-title" class="contact-title display">¿Conversamos?</h2>
      <p class="lead">Escríbeme por correo o LinkedIn. Respondo a propuestas de trabajo, proyectos y colaboraciones.</p>
      <div class="contact-row">
        <a class="contact-mail" href={`mailto:${profile.email}`}>{profile.email}</a>
        <button type="button" class="btn btn-secondary" data-copy={profile.email}>
          <span data-copy-icon><Icon name="copy" size={16} /></span>
          <span data-copy-label>Copiar correo</span>
        </button>
      </div>
      <div class="contact-links">
        <a class="btn btn-ghost" href={profile.links.github} target="_blank" rel="me noopener"><Icon name="github" size={16} /> github.com/tamoil-0</a>
        <a class="btn btn-ghost" href={profile.links.linkedin} target="_blank" rel="me noopener"><Icon name="linkedin" size={16} /> LinkedIn</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(var(--s-8), 12vw, 160px) clamp(var(--s-7), 8vw, var(--s-9)); }
  .hero-title { font-size: var(--step-4); line-height: 1; margin-top: var(--s-5); max-width: 14ch; }
  .hero-role { margin-top: var(--s-5); font-size: var(--step-1); font-weight: 500; }
  .hero-tagline { margin-top: var(--s-3); max-width: 60ch; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3); margin-top: var(--s-6); }
  .hero-links { display: inline-flex; gap: var(--s-1); }
  .hero-stats {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s-4);
    margin: var(--s-8) 0 0; padding-top: var(--s-5); border-top: 1px solid var(--line); max-width: 720px;
  }
  .hero-stats dt { font-size: var(--step--1); color: var(--muted); }
  .hero-stats dd { margin: 0; font-family: var(--font-serif); font-size: var(--step-3); line-height: 1.1; }

  .featured { display: grid; gap: clamp(var(--s-7), 7vw, var(--s-9)); }
  .feat { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--s-6); align-items: center; }
  .feat-media {
    grid-column: 1 / span 7; display: block; aspect-ratio: 16 / 10; overflow: hidden;
    border-radius: var(--radius); border: 1px solid var(--line); background: var(--surface-2);
  }
  .feat-media :global(img), .feat-media :global(svg) { width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform 600ms var(--ease); }
  .feat:hover .feat-media :global(img), .feat:hover .feat-media :global(svg) { transform: scale(1.025); }
  .feat-body { grid-column: 8 / span 5; display: grid; gap: var(--s-4); }
  .feat.is-alt .feat-media { grid-column: 6 / span 7; grid-row: 1; }
  .feat.is-alt .feat-body { grid-column: 1 / span 5; grid-row: 1; }
  .feat-meta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3); font-size: var(--step--1); }
  .feat-title { font-size: var(--step-3); }
  .feat-title a { text-decoration: none; }
  .feat-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2); margin-top: var(--s-2); }

  .filters { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s-4); margin-bottom: var(--s-6); }
  .chips { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .chip {
    display: inline-flex; align-items: center; gap: var(--s-2); min-height: 40px; padding: 0 var(--s-4);
    border-radius: 999px; border: 1px solid var(--line); background: var(--surface); color: var(--text);
    font: inherit; font-size: var(--step--1); cursor: pointer;
    transition: background var(--dur) var(--ease), color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .chip span { color: var(--muted); font-size: 0.8em; }
  .chip:hover { border-color: var(--text); }
  .chip[aria-pressed='true'] { background: var(--text); color: var(--bg); border-color: var(--text); }
  .chip[aria-pressed='true'] span { color: inherit; opacity: 0.7; }
  .search {
    display: flex; align-items: center; gap: var(--s-2); min-height: 44px; padding: 0 var(--s-4);
    border: 1px solid var(--line); border-radius: 999px; background: var(--surface); color: var(--muted);
    flex: 1 1 260px; max-width: 340px;
  }
  .search:focus-within { border-color: var(--accent); }
  .search input { border: 0; outline: 0; background: transparent; color: var(--text); font: inherit; font-size: var(--step--1); width: 100%; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: var(--s-5); }
  .charts { position: relative; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-5); margin-bottom: var(--s-7); }
  .chart { margin: 0; padding: var(--s-5); border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
  .chart-title { font-size: var(--step--1); font-weight: 600; margin-bottom: var(--s-4); }
  .chart-title .muted { font-weight: 400; }
  .bars { list-style: none; display: grid; gap: 2px; }
  .bar-row {
    width: 100%; display: grid; grid-template-columns: 132px minmax(0, 1fr) 28px; align-items: center; gap: var(--s-3);
    padding: 7px var(--s-2); border: 0; border-radius: var(--radius-sm); background: transparent; color: var(--text);
    font: inherit; font-size: var(--step--1); text-align: left; cursor: pointer; transition: background var(--dur) var(--ease);
  }
  .bar-row:hover, .bar-row:focus-visible, .bar-row.is-active { background: var(--surface-2); }
  .bar-label { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--muted); }
  .bar-row.is-active .bar-label { color: var(--text); font-weight: 600; }
  .bar-track { height: 14px; display: block; }
  .bar-fill {
    display: block; height: 100%; width: var(--w); min-width: 4px; background: var(--accent);
    border-radius: 0 4px 4px 0; transform-origin: left; transition: opacity var(--dur) var(--ease);
  }
  .bars:has(.is-active) .bar-row:not(.is-active) .bar-fill { opacity: 0.35; }
  .bar-value { font-variant-numeric: tabular-nums; font-weight: 600; text-align: right; }
  .chart-tip {
    position: absolute; z-index: 5; pointer-events: none; transform: translateY(-50%); opacity: 0;
    padding: 6px 10px; border-radius: var(--radius-sm); background: var(--text); color: var(--bg);
    font-size: 0.8rem; white-space: nowrap; transition: opacity 150ms var(--ease);
  }
  .chart-tip.is-on { opacity: 1; }
  .reveal.is-visible .bar-fill { animation: grow 700ms var(--ease) both; }
  @keyframes grow { from { transform: scaleX(0); } }
  .filters-2 { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s-3); margin: calc(-1 * var(--s-3)) 0 var(--s-5); }
  .chip-sm { min-height: 36px; padding: 0 var(--s-3); font-size: 0.82rem; }
  .chip-sm :global(svg) { width: 14px; height: 14px; }
  .chip-tech { background: var(--accent-soft); color: var(--accent); border-color: transparent; font-weight: 600; cursor: default; padding-right: 4px; }
  .chip-tech[hidden] { display: none; }
  .chip-x { display: grid; place-items: center; width: 28px; height: 28px; border: 0; border-radius: 999px; background: transparent; color: inherit; cursor: pointer; }
  .chip-x:hover { background: color-mix(in srgb, var(--accent) 15%, transparent); }
  .sort { display: inline-flex; align-items: center; gap: var(--s-2); font-size: var(--step--1); }
  .sort select { font: inherit; color: var(--text); background: var(--surface); border: 1px solid var(--line); border-radius: 999px; padding: 6px 12px; min-height: 36px; cursor: pointer; }
  .results { font-size: var(--step--1); margin-bottom: var(--s-4); }
  .empty { display: grid; justify-items: center; gap: var(--s-4); padding: var(--s-7) 0; }
  .empty[hidden] { display: none; }
  @media (max-width: 900px) { .charts { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 420px) { .bar-row { grid-template-columns: 104px minmax(0, 1fr) 24px; } }

  .about-head { grid-column: 1 / span 4; display: grid; gap: var(--s-3); align-content: start; }
  .about-body { grid-column: 6 / span 7; display: grid; gap: var(--s-4); font-size: var(--step-1); line-height: 1.6; }
  .about-sub { font-size: var(--step--1); text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-top: var(--s-4); font-weight: 500; }
  .about-list { list-style: none; display: grid; gap: var(--s-2); }
  .about-list li { padding-left: var(--s-5); position: relative; }
  .about-list li::before { content: ''; position: absolute; left: 0; top: 0.8em; width: 10px; height: 1px; background: var(--accent); }

  .skills { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: var(--s-5); }
  .skill-group { padding: var(--s-5); border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); display: grid; gap: var(--s-4); align-content: start; }
  .skill-group h3 { font-size: var(--step-0); }

  .about-photo {
    width: 100%; max-width: 260px; aspect-ratio: 4 / 5; object-fit: cover; margin-top: var(--s-5);
    border-radius: var(--radius); border: 1px solid var(--line); filter: grayscale(0.15);
  }
  .tray { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--s-8); }
  .tray-side { display: grid; gap: var(--s-6); align-content: start; }
  .tray-block { display: grid; gap: var(--s-2); padding-bottom: var(--s-6); border-bottom: 1px solid var(--line); }
  .tray-block:last-child { border-bottom: 0; }
  .tray-h { font-size: var(--step--1); text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); font-weight: 500; margin-bottom: var(--s-3); }
  .timeline { list-style: none; display: grid; gap: var(--s-6); border-left: 1px solid var(--line); padding-left: var(--s-6); }
  .tl-item { position: relative; display: grid; gap: 2px; }
  .tl-item::before {
    content: ''; position: absolute; left: calc(-1 * var(--s-6) - 5px); top: 0.45em;
    width: 9px; height: 9px; border-radius: 50%; background: var(--bg); border: 2px solid var(--accent);
  }
  .tl-period { font-size: var(--step--1); }
  .tl-role { font-size: var(--step-1); font-weight: 600; }
  .tl-org { font-weight: 500; }
  .tl-org a { text-decoration: none; color: var(--accent); }
  .tl-org a:hover { text-decoration: underline; }
  .tl-sum { font-size: var(--step--1); margin-top: var(--s-2); max-width: 60ch; }
  .dash-list { list-style: none; display: grid; gap: var(--s-2); font-size: var(--step--1); margin-top: var(--s-2); }
  .dash-list li { padding-left: var(--s-5); position: relative; }
  .dash-list li::before { content: ''; position: absolute; left: 0; top: 0.8em; width: 10px; height: 1px; background: var(--accent); }
  .awards { list-style: none; display: grid; gap: var(--s-4); }
  .awards li { display: grid; gap: 2px; font-size: var(--step--1); }
  .awards strong { font-size: var(--step-0); font-weight: 600; }
  .awards a { text-decoration: none; }
  .awards a:hover { color: var(--accent); }
  @media (max-width: 900px) { .tray { grid-template-columns: minmax(0, 1fr); gap: var(--s-7); } }

  .contact { text-align: left; }
  .contact-title { font-size: var(--step-4); line-height: 1; margin: var(--s-4) 0; }
  .contact-row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-4); margin-top: var(--s-6); }
  .contact-mail { font-size: var(--step-2); font-weight: 500; letter-spacing: -0.02em; word-break: break-all; }
  .contact-links { display: flex; flex-wrap: wrap; gap: var(--s-2); margin-top: var(--s-5); margin-left: calc(-1 * var(--s-3)); }

  @media (max-width: 900px) {
    .feat, .feat.is-alt { grid-template-columns: minmax(0, 1fr); gap: var(--s-5); }
    .feat-media, .feat-body, .feat.is-alt .feat-media, .feat.is-alt .feat-body { grid-column: 1; grid-row: auto; }
    .about-head, .about-body { grid-column: 1 / -1; }
  }
  @media (max-width: 560px) {
    .hero-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .search { max-width: none; }
  }
</style>

<script>
  // Filtros: categoría, búsqueda, tecnología (desde el gráfico), toggles y orden
  const chips = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const toggles = document.querySelectorAll<HTMLButtonElement>('[data-toggle]');
  const grid = document.querySelector<HTMLElement>('[data-grid]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-card]')];
  const input = document.querySelector<HTMLInputElement>('[data-search-input]');
  const sort = document.querySelector<HTMLSelectElement>('[data-sort]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const count = document.querySelector<HTMLElement>('[data-results-count]');
  const techChip = document.querySelector<HTMLElement>('[data-tech-chip]');
  const techName = document.querySelector<HTMLElement>('[data-tech-name]');
  const catBars = document.querySelectorAll<HTMLButtonElement>('[data-chart-cat]');
  const techBars = document.querySelectorAll<HTMLButtonElement>('[data-chart-tech]');
  const state = { cat: 'all', tech: '', on: new Set<string>() };

  const apply = () => {
    const q = (input?.value ?? '').trim().toLowerCase();
    let shown = 0;
    cards.forEach((c) => {
      const d = c.dataset;
      const ok =
        (state.cat === 'all' || (d.categories ?? '').split('|').includes(state.cat)) &&
        (!state.tech || (d.techs ?? '').split('|').includes(state.tech)) &&
        (!q || (d.search ?? '').includes(q)) &&
        (!state.on.has('live') || d.live === '1') &&
        (!state.on.has('private') || d.private === '1') &&
        (!state.on.has('team') || d.team === '1');
      if (ok) {
        if (c.hidden) { c.hidden = false; c.animate?.([{ opacity: 0, transform: 'translateY(8px)' }, { opacity: 1, transform: 'none' }], { duration: 260, easing: 'ease-out' }); }
        c.classList.add('is-visible');
        shown++;
      } else c.hidden = true;
    });
    if (empty) empty.hidden = shown > 0;
    if (count) count.textContent = `${shown} ${shown === 1 ? 'proyecto' : 'proyectos'}`;
    chips.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.filter === state.cat)));
    catBars.forEach((x) => x.classList.toggle('is-active', x.dataset.chartCat === state.cat));
    techBars.forEach((x) => x.classList.toggle('is-active', x.dataset.chartTech === state.tech));
    if (techChip && techName) { techChip.hidden = !state.tech; techName.textContent = state.tech; }
  };
  const reorder = () => {
    const by = sort?.value === 'recent'
      ? (a: HTMLElement, b: HTMLElement) => (b.dataset.start ?? '').localeCompare(a.dataset.start ?? '')
      : (a: HTMLElement, b: HTMLElement) => Number(a.dataset.order) - Number(b.dataset.order);
    [...cards].sort(by).forEach((c) => grid?.appendChild(c));
  };
  const goGrid = () => grid?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });

  chips.forEach((b) => b.addEventListener('click', () => { state.cat = b.dataset.filter ?? 'all'; apply(); }));
  toggles.forEach((b) => b.addEventListener('click', () => {
    const k = b.dataset.toggle!;
    if (state.on.has(k)) state.on.delete(k); else state.on.add(k);
    b.setAttribute('aria-pressed', String(state.on.has(k)));
    apply();
  }));
  catBars.forEach((b) => b.addEventListener('click', () => {
    state.cat = state.cat === b.dataset.chartCat ? 'all' : b.dataset.chartCat!;
    apply(); goGrid();
  }));
  techBars.forEach((b) => b.addEventListener('click', () => {
    state.tech = state.tech === b.dataset.chartTech ? '' : b.dataset.chartTech!;
    apply(); goGrid();
  }));
  document.querySelector('[data-tech-clear]')?.addEventListener('click', () => { state.tech = ''; apply(); });
  document.querySelector('[data-reset]')?.addEventListener('click', () => {
    state.cat = 'all'; state.tech = ''; state.on.clear();
    if (input) input.value = '';
    toggles.forEach((t) => t.setAttribute('aria-pressed', 'false'));
    apply();
  });
  input?.addEventListener('input', apply);
  sort?.addEventListener('change', reorder);

  // Tooltip de los gráficos (hover y foco). El valor también está escrito en cada barra.
  const tip = document.querySelector<HTMLElement>('[data-chart-tip]');
  const charts = document.querySelector<HTMLElement>('.charts');
  document.querySelectorAll<HTMLElement>('.bar-row').forEach((row) => {
    const show = () => {
      if (!tip || !charts) return;
      const [value, ...rest] = (row.dataset.tip ?? '').split(' ');
      tip.replaceChildren();
      const strong = document.createElement('strong');
      strong.textContent = value;
      tip.append(strong, document.createTextNode(' ' + rest.join(' ')));
      const r = row.querySelector('.bar-fill')!.getBoundingClientRect();
      const c = charts.getBoundingClientRect();
      tip.style.left = `${Math.min(r.right - c.left + 12, c.width - 230)}px`;
      tip.style.top = `${r.top - c.top + r.height / 2}px`;
      tip.classList.add('is-on');
    };
    const hide = () => tip?.classList.remove('is-on');
    row.addEventListener('pointerenter', show);
    row.addEventListener('focus', show);
    row.addEventListener('pointerleave', hide);
    row.addEventListener('blur', hide);
  });

  // Copiar correo
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => b.addEventListener('click', async () => {
    const label = b.querySelector('[data-copy-label]');
    try {
      await navigator.clipboard.writeText(b.dataset.copy ?? '');
      if (label) label.textContent = '¡Copiado!';
    } catch {
      if (label) label.textContent = 'No se pudo copiar';
    }
    setTimeout(() => { if (label) label.textContent = 'Copiar correo'; }, 2000);
  }));
</script>
