---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Gallery from '../../components/Gallery.astro';
import ProjectMedia from '../../components/ProjectMedia.astro';
import {
  ACCESS_LABEL, catClass, fmtPeriod, profile, projects, projectUrl, teamLabel, url, whatsappUrl, type Project,
} from '../../lib/site';

export function getStaticPaths() {
  const n = projects.length;
  // Navegación circular: siempre hay anterior y siguiente.
  return projects.map((p, i) => ({
    params: { slug: p.slug },
    props: {
      project: p,
      prev: n > 1 ? projects[(i - 1 + n) % n] : null,
      next: n > 2 ? projects[(i + 1) % n] : null,
    },
  }));
}
interface Props { project: Project; prev: Project | null; next: Project | null }
const { project: p, prev, next } = Astro.props;

const ogImage = p.images[0]?.src;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: p.title,
  description: p.shortDescription,
  abstract: p.longDescription,
  keywords: p.stack.join(', '),
  dateCreated: p.period.start,
  creator: { '@type': 'Person', name: profile.name, url: new URL(url(), Astro.site).href },
  url: new URL(projectUrl(p), Astro.site).href,
  ...(p.liveUrl ? { sameAs: [p.liveUrl] } : {}),
  ...(ogImage ? { image: new URL(url(ogImage), Astro.site).href } : {}),
};

const access = p.liveUrl ? null : (p.access ?? null);
const host = (() => {
  try { return p.liveUrl ? new URL(p.liveUrl).hostname.replace(/^www\./, '') : null; } catch { return null; }
})();
const words = p.title.split(/\s+/);

// "Profesional: producto comercial de…" → tipo + detalle
const [ctxKind, ...ctxRest] = p.context.split(':');
const ctxDetail = ctxRest.join(':').trim();
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

const waText = whatsappUrl(`Hola Jhon, vi tu proyecto ${p.title} en tu portafolio.`);
const mailHref = `mailto:${profile.email}?subject=${encodeURIComponent(`Consulta sobre ${p.title}`)}`;

const I = {
  calendar: '<rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path d="M3.5 10h17M8 3v4M16 3v4"/>',
  users: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0M16 4.5a3.5 3.5 0 0 1 0 7M18 14a6.5 6.5 0 0 1 3.5 6"/>',
  pulse: '<path d="M3 12h4l2.5-6 5 12 2.5-6h4"/>',
  briefcase: '<rect x="3" y="7" width="18" height="13" rx="2.5"/><path d="M8.5 7V5.5a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2V7M3 12.5h18"/>',
  user: '<circle cx="12" cy="8" r="4"/><path d="M4 20.5a8 8 0 0 1 16 0"/>',
  alert: '<path d="M12 3.5 2.5 20h19L12 3.5Z"/><path d="M12 10v4.5M12 17.2v.3"/>',
  bulb: '<path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.6 10.8c.7.5 1.1 1.3 1.1 2.2h5c0-.9.4-1.7 1.1-2.2A6 6 0 0 0 12 3Z"/>',
  chevron: '<path d="m6 9 6 6 6-6"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>',
  cpu: '<rect x="6" y="6" width="12" height="12" rx="2"/><path d="M9 2.5v3M15 2.5v3M9 18.5v3M15 18.5v3M2.5 9h3M2.5 15h3M18.5 9h3M18.5 15h3"/>',
};
const WA = '<path fill="currentColor" d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.39-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.2-.24-.59-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.7.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.18-1.41-.08-.13-.27-.2-.57-.35M12.05 21.79h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.89-9.88 2.64 0 5.12 1.03 6.99 2.9a9.82 9.82 0 0 1 2.89 6.99c0 5.45-4.44 9.88-9.88 9.88m8.41-18.3A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.69 1.45h.01c6.55 0 11.89-5.34 11.89-11.89 0-3.18-1.24-6.16-3.48-8.41Z"/>';

const facts = [
  { icon: I.calendar, k: 'Periodo', v: fmtPeriod(p.period), sub: '' },
  { icon: I.users, k: 'Equipo', v: teamLabel(p.teamSize), sub: '' },
  { icon: I.pulse, k: 'Estado', v: p.status, sub: '', live: !!p.liveUrl },
  { icon: I.briefcase, k: 'Contexto', v: ctxRest.length ? ctxKind.trim() : p.context, sub: ctxDetail ? cap(ctxDetail) : '' },
];
const hasTech = p.stack.length > 0 || !!p.ai || (p.architecture?.length ?? 0) > 0;
const techParts = [p.stack.length > 0 && 'stack', (p.architecture?.length ?? 0) > 0 && 'arquitectura', p.ai && 'modelos de IA']
  .filter(Boolean) as string[];
const techSummary = cap(techParts.length > 1 ? `${techParts.slice(0, -1).join(', ')} y ${techParts.at(-1)}` : techParts[0] ?? '');
---
<Base title={p.title} description={p.shortDescription} image={ogImage ? url(ogImage) : undefined} type="article" jsonLd={jsonLd}>
  <article class="detail">
    <!-- ============ Hero ============ -->
    <header class="hero">
      <div class="hero-bg" aria-hidden="true">
        <span class="blob b1"></span><span class="blob b2"></span><span class="blob b3"></span>
        <span class="hero-grid"></span>
      </div>

      <div class="container hero-copy">
        <a class="back in" style="--i:0" href={url('#todos')}>
          <span class="back-ico"><Icon name="arrowLeft" size={16} /></span> Todos los proyectos
        </a>

        <p class="pills in" style="--i:1">
          <span class={`badge ${catClass(p.category)}`}>{p.category}</span>
          {p.liveUrl
            ? <span class="badge status is-live"><span class="live-dot"></span>En línea</span>
            : <span class="badge status"><Icon name="lock" size={12} />{p.status}</span>}
        </p>

        <h1 class="title display">
          {words.map((w, i) => <><span class="w" style={`--w:${i}`}>{w}</span>{i < words.length - 1 ? ' ' : ''}</>)}
        </h1>
        <p class="lead in" style="--i:4">{p.shortDescription}</p>

        <div class="actions in" style="--i:5">
          {p.liveUrl && (
            <a class="btn btn-primary" href={p.liveUrl} target="_blank" rel="noopener">
              Ver página <Icon name="external" size={16} />
            </a>
          )}
          <a class="btn btn-wa" href={waText} target="_blank" rel="noopener">
            <svg class="wa" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" set:html={WA} />
            Consultar por WhatsApp
          </a>
        </div>

        {!p.liveUrl && (
          <aside class="notice in" style="--i:6" aria-label="Por qué no tiene página pública">
            <span class="notice-ico"><Icon name="lock" size={20} /></span>
            <div class="notice-text">
              <p class="notice-title">{access ? (ACCESS_LABEL[access.type] ?? 'Sin página pública') : 'Sin página pública'}</p>
              <p class="notice-note">
                {access?.note || 'Proyecto sin página pública: abajo muestro cómo funciona con capturas e ilustraciones.'}
              </p>
            </div>
          </aside>
        )}
      </div>

      <div class="container">
        <div class="stage">
          <div class="frame">
            <div class="frame-bar" aria-hidden="true">
              <span class="dots"><i></i><i></i><i></i></span>
              <span class="frame-url">
                {host
                  ? <><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" set:html={I.globe} />{host}</>
                  : <><Icon name="lock" size={12} />proyecto privado</>}
              </span>
              <span class="dots-spacer"></span>
            </div>
            <div class="frame-media" style={`view-transition-name: media-${p.slug}`}>
              <ProjectMedia project={p} eager sizes="(min-width: 1200px) 1130px, 100vw" />
            </div>
          </div>
        </div>
      </div>
    </header>

    <div class="container body">
      <!-- ============ Datos rápidos ============ -->
      <section class="facts" aria-label="Ficha del proyecto">
        {facts.map((f, i) => (
          <div class="fact reveal" style={`--d:${i * 70}ms`}>
            <span class="fact-ico"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={f.icon} /></span>
            <p class="fact-k">{f.k}</p>
            <p class="fact-v">{f.live && <span class="live-dot"></span>}{f.v}</p>
            {f.sub && <p class="fact-sub">{f.sub}</p>}
          </div>
        ))}
        <div class="fact fact-role reveal" style="--d:280ms">
          <span class="fact-ico"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={I.user} /></span>
          <div>
            <p class="fact-k">Mi rol</p>
            <p class="fact-role-text">{p.role}</p>
          </div>
        </div>
      </section>

      <!-- ============ Resumen ============ -->
      <section class="split" aria-labelledby="sec-resumen">
        <header class="split-head reveal">
          <p class="eyebrow">Visión general</p>
          <h2 id="sec-resumen" class="sec-title">Resumen</h2>
        </header>
        <p class="summary reveal" style="--d:100ms">{p.longDescription}</p>
      </section>

      <!-- ============ Problema / solución ============ -->
      {(p.problem || p.solution) && (
        <section class="block" aria-labelledby="sec-ps">
          <header class="block-head reveal">
            <p class="eyebrow">El reto</p>
            <h2 id="sec-ps" class="sec-title">Del problema a la solución</h2>
          </header>
          <div class="ps">
            {p.problem && (
              <div class="reveal"><div class="ps-card ps-problem">
                <span class="ps-ico"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={I.alert} /></span>
                <h3 class="ps-title">El problema</h3>
                <p>{p.problem}</p>
              </div></div>
            )}
            {p.problem && p.solution && (
              <span class="ps-arrow" aria-hidden="true"><Icon name="arrowRight" size={18} /></span>
            )}
            {p.solution && (
              <div class="reveal" style="--d:120ms"><div class="ps-card ps-solution">
                <span class="ps-ico"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={I.bulb} /></span>
                <h3 class="ps-title">La solución</h3>
                <p>{p.solution}</p>
              </div></div>
            )}
          </div>
        </section>
      )}

      <!-- ============ Cómo funciona ============ -->
      {p.howItWorks.length > 0 && (
        <section class="split" aria-labelledby="sec-how">
          <header class="split-head reveal">
            <p class="eyebrow">Paso a paso</p>
            <h2 id="sec-how" class="sec-title">Cómo funciona</h2>
            <p class="muted split-sub">{p.howItWorks.length} pasos, de principio a fin.</p>
          </header>
          <ol class="steps">
            {p.howItWorks.map((s, i) => (
              <li class="step reveal" style={`--d:${i * 80}ms`}>
                <span class="step-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <p class="step-body">{s}</p>
              </li>
            ))}
          </ol>
        </section>
      )}

      <!-- ============ Galería ============ -->
      {p.images.length > 0 && (
        <section class="block" aria-labelledby="sec-gal">
          <header class="block-head reveal">
            <p class="eyebrow">Galería</p>
            <h2 id="sec-gal" class="sec-title">{p.images.every((i) => i.generated) ? 'Cómo se ve y cómo funciona' : 'Capturas'}</h2>
            <p class="muted">Toca una imagen para ampliarla.</p>
          </header>
          <div class="reveal" style="--d:100ms">
            <Gallery images={p.images} title={p.title} />
          </div>
        </section>
      )}

      <!-- ============ Resultados ============ -->
      {p.results.length > 0 && (
        <section class="block" aria-labelledby="sec-res">
          <header class="block-head reveal">
            <p class="eyebrow">Impacto</p>
            <h2 id="sec-res" class="sec-title">Resultados</h2>
          </header>
          <ul class="results">
            {p.results.map((r, i) => (
              <li class="reveal" style={`--d:${i * 80}ms`}>
                <div class="result">
                  <span class="result-ico"><Icon name="check" size={18} /></span>
                  <p>{r}</p>
                </div>
              </li>
            ))}
          </ul>
        </section>
      )}

      <!-- ============ Detalles técnicos ============ -->
      {hasTech && (
        <div class="reveal"><details class="tech">
          <summary>
            <span class="tech-ico"><Icon name="code" size={20} /></span>
            <span class="tech-sum">
              <strong>Detalles técnicos</strong>
              <span class="muted">{techSummary}</span>
            </span>
            <span class="chev" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={I.chevron} /></span>
          </summary>
          <div class="tech-body">
            {p.stack.length > 0 && (
              <div class="tech-block">
                <h3 class="tech-h">Stack</h3>
                <ul class="badges">{p.stack.map((s) => <li class="badge mono">{s}</li>)}</ul>
              </div>
            )}
            {(p.architecture?.length ?? 0) > 0 && (
              <div class="tech-block">
                <h3 class="tech-h">Arquitectura</h3>
                <ul class="arch">{p.architecture.map((a) => <li>{a}</li>)}</ul>
              </div>
            )}
            {p.ai && (
              <div class="tech-block">
                <h3 class="tech-h">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={I.cpu} />
                  Inteligencia artificial
                </h3>
                <dl class="ai">
                  {p.ai.technique && <div><dt>Técnica</dt><dd>{p.ai.technique}</dd></div>}
                  {p.ai.models.length > 0 && <div><dt>Modelos</dt><dd>{p.ai.models.join(', ')}</dd></div>}
                  {p.ai.datasets.length > 0 && <div><dt>Datos</dt><dd>{p.ai.datasets.join(', ')}</dd></div>}
                  {p.ai.metrics.length > 0 && <div><dt>Métricas</dt><dd>{p.ai.metrics.join(' · ')}</dd></div>}
                </dl>
              </div>
            )}
          </div>
        </details></div>
      )}

      <!-- ============ CTA ============ -->
      <section class="cta reveal" aria-labelledby="sec-cta">
        <div class="cta-bg" aria-hidden="true"><span></span><span></span></div>
        <p class="eyebrow cta-eyebrow">Hablemos</p>
        <h2 id="sec-cta" class="cta-title display">¿Te interesa algo así?</h2>
        <p class="cta-text">Si tienes una idea parecida o quieres saber más de {p.title}, escríbeme y lo conversamos.</p>
        <div class="cta-actions">
          <a class="btn btn-wa" href={waText} target="_blank" rel="noopener">
            <svg class="wa" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" set:html={WA} />
            Consultar por WhatsApp
          </a>
          <a class="btn btn-light" href={mailHref}><Icon name="mail" size={18} /> {profile.email}</a>
        </div>
      </section>

      <!-- ============ Anterior / siguiente ============ -->
      {(prev || next) && (
        <nav class="pager" aria-label="Más proyectos">
          {[prev, next].map((q, i) => q ? (
            <a class:list={['pg', i === 1 && 'is-next']} href={projectUrl(q)}>
              <span class="pg-media"><ProjectMedia project={q} sizes="200px" /></span>
              <span class="pg-body">
                <span class="pg-dir">
                  {i === 0 ? <><span class="pg-arrow"><Icon name="arrowLeft" size={14} /></span> Anterior</> : <>Siguiente <span class="pg-arrow"><Icon name="arrowRight" size={14} /></span></>}
                </span>
                <strong class="pg-title">{q.title}</strong>
                <span class={`badge ${catClass(q.category)}`}>{q.category}</span>
              </span>
            </a>
          ) : <span />)}
        </nav>
      )}
    </div>
  </article>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero { position: relative; isolation: isolate; padding-top: var(--s-6); }
  .hero-bg {
    position: absolute; z-index: -1; inset: calc(-1 * var(--nav-h)) 0 auto; height: min(1000px, 130vh);
    overflow: hidden; pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent);
    mask-image: linear-gradient(to bottom, #000 55%, transparent);
  }
  .blob { position: absolute; border-radius: 50%; filter: blur(90px); opacity: 0.32; will-change: transform; }
  .b1 { width: min(560px, 90vw); aspect-ratio: 1; background: var(--accent); top: -140px; left: -10%; animation: drift-a 22s ease-in-out infinite alternate; }
  .b2 { width: min(480px, 80vw); aspect-ratio: 1; background: var(--accent-2); top: 20px; right: -12%; opacity: 0.26; animation: drift-b 26s ease-in-out infinite alternate; }
  .b3 { width: min(400px, 70vw); aspect-ratio: 1; background: var(--accent-3); top: 340px; left: 38%; opacity: 0.16; animation: drift-c 30s ease-in-out infinite alternate; }
  @keyframes drift-a { to { transform: translate(18vw, 60px) scale(1.15); } }
  @keyframes drift-b { to { transform: translate(-14vw, 120px) scale(0.9); } }
  @keyframes drift-c { to { transform: translate(-20vw, -80px) scale(1.2); } }
  .hero-grid {
    position: absolute; inset: 0; opacity: 0.55;
    background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: radial-gradient(ellipse 70% 55% at 50% 10%, #000 20%, transparent 75%);
    mask-image: radial-gradient(ellipse 70% 55% at 50% 10%, #000 20%, transparent 75%);
  }

  .hero-copy { display: grid; justify-items: start; gap: var(--s-4); }
  .in { animation: rise 900ms var(--ease) both; animation-delay: calc(var(--i, 0) * 90ms + 40ms); }
  @keyframes rise { from { opacity: 0; transform: translateY(18px); filter: blur(6px); } }

  .back {
    display: inline-flex; align-items: center; gap: var(--s-2); min-height: 44px; margin-bottom: var(--s-2);
    font-size: var(--step--1); font-weight: 500; text-decoration: none; color: var(--muted);
  }
  .back-ico {
    display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%;
    border: 1px solid var(--line-strong); background: var(--glass);
    transition: transform var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .back:hover .back-ico { transform: translateX(-3px); border-color: var(--accent); }

  .pills { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .status { background: var(--glass); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
  .status.is-live { color: var(--text); font-weight: 600; }

  .title { font-size: var(--step-4); line-height: 0.98; max-width: 16ch; overflow-wrap: anywhere; hyphens: auto; }
  .w {
    display: inline-block; animation: word-in 1000ms var(--ease) both;
    animation-delay: calc(var(--w) * 70ms + 220ms);
  }
  @keyframes word-in { from { opacity: 0; transform: translateY(0.45em) rotate(2deg); filter: blur(10px); } }
  .lead { max-width: 62ch; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-2); }
  .wa { width: 18px; height: 18px; }
  .btn-wa:hover .wa { transform: rotate(-8deg) scale(1.08); }

  .notice {
    position: relative; display: flex; gap: var(--s-4); align-items: flex-start; max-width: 640px; margin-top: var(--s-3);
    padding: var(--s-4) var(--s-5); border-radius: var(--radius);
    background: var(--glass); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); box-shadow: var(--shadow);
  }
  .notice::before {
    content: ''; position: absolute; inset: 0; padding: 1px; border-radius: inherit; pointer-events: none;
    background: var(--grad);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor; mask-composite: exclude;
    opacity: 0.55;
  }
  .notice-ico {
    flex: none; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 14px;
    background: var(--grad); color: #fff; box-shadow: 0 8px 20px -8px rgb(90 60 244 / 0.7);
  }
  .notice-text { display: grid; gap: 2px; min-width: 0; }
  .notice-title { font-weight: 650; font-family: var(--font-display); font-size: var(--step-0); }
  .notice-note { font-size: var(--step--1); color: var(--muted); line-height: 1.55; }

  /* Ventana de navegador */
  .stage { position: relative; margin-top: var(--s-7); perspective: 1800px; }
  .stage::before {
    content: ''; position: absolute; z-index: -1; inset: 12% 8% -6%; border-radius: 50%;
    background: var(--grad); filter: blur(80px); opacity: 0.28;
  }
  .frame {
    position: relative; overflow: hidden; border-radius: var(--radius-lg);
    border: 1px solid var(--line-strong); background: var(--surface); box-shadow: var(--shadow-lg);
    transform-origin: 50% 0; animation: frame-in 1300ms var(--ease) 380ms both;
  }
  @keyframes frame-in { from { opacity: 0; transform: translateY(56px) rotateX(10deg) scale(0.96); } }
