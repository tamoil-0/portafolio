---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { projects, url } from '../lib/site';
---
<Base title="Página no encontrada" description="La página que buscas no existe.">
  <section class="nf">
    <div class="nf-bg" aria-hidden="true">
      <span class="blob b1"></span><span class="blob b2"></span><span class="nf-grid"></span>
    </div>

    <div class="container nf-inner">
      <p class="eyebrow in" style="--i:0">Error 404</p>

      <p class="digits in" style="--i:1" aria-hidden="true">404</p>

      <h1 class="nf-title display in" style="--i:2">Te perdiste en el altiplano.</h1>
      <p class="lead in" style="--i:3">
        La página que buscas no existe o cambió de dirección. Pero hay {projects.length} proyectos esperándote.
      </p>
      <div class="nf-actions in" style="--i:4">
        <a class="btn btn-primary" href={url()}><Icon name="arrowLeft" size={16} /> Volver al inicio</a>
        <a class="btn btn-secondary" href={url('#todos')}>Ver proyectos <Icon name="arrowRight" size={16} /></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf { position: relative; isolation: isolate; overflow: hidden; min-height: calc(100svh - var(--nav-h)); display: grid; align-items: center; padding-block: var(--s-8); }
  .nf-bg { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  /* Fondo estático y tenue */
  .blob { position: absolute; border-radius: 50%; filter: blur(100px); opacity: 0.18; }
  .b1 { width: min(560px, 90vw); aspect-ratio: 1; background: var(--accent); top: -10%; left: -8%; }
  .b2 { width: min(480px, 80vw); aspect-ratio: 1; background: var(--accent-2); bottom: -15%; right: -10%; opacity: 0.14; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .blob { opacity: 0.14; }
  }
  :global(:root[data-theme='dark']) .blob { opacity: 0.14; }
  .nf-grid {
    position: absolute; inset: 0; opacity: 0.4;
    background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: radial-gradient(ellipse 60% 60% at 50% 45%, #000 20%, transparent 75%);
    mask-image: radial-gradient(ellipse 60% 60% at 50% 45%, #000 20%, transparent 75%);
  }

  .nf-inner { display: grid; justify-items: center; text-align: center; gap: var(--s-5); }
  .nf-inner .eyebrow::before { background: var(--accent); }
  .in { animation: rise var(--dur-4, 520ms) var(--ease-out, cubic-bezier(.16, 1, .3, 1)) both; animation-delay: calc(var(--i, 0) * 70ms + 60ms); }
  @keyframes rise { from { opacity: 0; transform: translateY(10px); } }

  /* "404" estático con el degradado de marca (único uso en pantalla) */
  .digits {
    font-family: var(--font-display); font-weight: 800; font-size: clamp(6.5rem, 24vw, 14rem); line-height: 0.9; letter-spacing: -0.06em;
    background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent;
    padding-inline: 0.04em;
  }

  .nf-title { font-size: var(--step-3); max-width: 18ch; }
  .lead { max-width: 52ch; line-height: 1.65; }
  .nf-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--s-3); margin-top: var(--s-2); }
  @media (max-width: 480px) {
    .nf-actions .btn { flex: 1 1 100%; }
  }
</style>
