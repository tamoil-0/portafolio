---
import Icon from './Icon.astro';
import ProjectMedia from './ProjectMedia.astro';
import { ACCESS_LABEL, catClass, categoriesOf, fmtPeriod, projectUrl, techsOf, type Project } from '../lib/site';
interface Props { project: Project }
const { project: p } = Astro.props;
const techs = techsOf(p);
const searchText = [p.title, p.shortDescription, p.context, ...p.stack, ...p.tags, ...techs].join(' ').toLowerCase();
---
<article
  class="card spot reveal"
  data-card
  data-categories={categoriesOf(p).join('|')}
  data-search={searchText}
  data-techs={techs.join('|')}
  data-live={p.liveUrl ? '1' : '0'}
  data-team={(p.teamSize ?? 1) > 1 ? '1' : '0'}
  data-start={p.period.start}
  data-order={p.order}
>
  <div class="card-media" style={`view-transition-name: media-${p.slug}`}>
    <ProjectMedia project={p} />
    {p.liveUrl ? (
      <span class="flag"><span class="live-dot" /> En línea</span>
    ) : (
      <span class="flag"><Icon name="lock" size={12} /> {p.access ? ACCESS_LABEL[p.access.type] : 'Sin página pública'}</span>
    )}
  </div>
  <div class="card-body">
    <p class="card-meta">
      <span class:list={['badge', catClass(p.category)]}>{p.category}</span>
      <span class="mono when">{fmtPeriod(p.period)}</span>
    </p>
    <h3 class="card-title"><a href={projectUrl(p)} class="stretched">{p.title}</a></h3>
    <p class="card-desc">{p.shortDescription}</p>
    <div class="card-foot">
      <span class="more">Ver proyecto <Icon name="arrowRight" size={16} /></span>
      {p.liveUrl && <a class="mini-link" href={p.liveUrl} target="_blank" rel="noopener">Ver página <Icon name="external" size={14} /></a>}
    </div>
  </div>
</article>

<style>
  .card {
    display: flex; flex-direction: column; border-radius: var(--radius-lg); overflow: hidden;
    background: linear-gradient(var(--surface), var(--surface)) padding-box, linear-gradient(180deg, var(--line-strong), var(--line) 40%) border-box;
    border: 1px solid transparent; box-shadow: inset 0 1px 0 var(--edge), var(--shadow-sm);
    transition: transform var(--dur-3) var(--ease-out), box-shadow var(--dur-3) var(--ease-out), opacity var(--dur-4) var(--ease-out);
  }
  .card:hover { transform: translateY(-2px); box-shadow: inset 0 1px 0 var(--edge), var(--shadow); }
  .card:focus-within { box-shadow: 0 0 0 2px var(--accent); }
  .card-media { position: relative; aspect-ratio: 16 / 10; overflow: hidden; margin: 8px 8px 0; border-radius: calc(var(--radius-lg) - 8px); background: var(--surface-2); border: 1px solid var(--line); }
  .card-media > :global(img), .card-media > :global(svg) { width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform 700ms var(--ease-out); }
  .card:hover .card-media > :global(img), .card:hover .card-media > :global(svg) { transform: scale(1.03); }
  .flag {
    position: absolute; left: 12px; bottom: 12px; z-index: 2; display: inline-flex; align-items: center; gap: 7px;
    padding: 5px 10px; border-radius: 999px; font-size: 0.72rem; font-weight: 550; color: var(--text);
    background: var(--glass); backdrop-filter: blur(10px) saturate(160%); -webkit-backdrop-filter: blur(10px) saturate(160%); border: 1px solid var(--line); box-shadow: var(--shadow-sm);
  }
  .card-body { position: relative; z-index: 1; display: flex; flex-direction: column; gap: var(--s-3); padding: var(--s-5); flex: 1; }
  .card-meta { display: flex; align-items: center; justify-content: space-between; gap: var(--s-2); }
  .when { font-size: var(--step--2); color: var(--faint); }
  .card-title { font-size: var(--step-0); font-weight: 600; }
  .card-title a { text-decoration: none; }
  .card-title a:hover { color: var(--text); }
  .stretched::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .card-desc { font-size: var(--step--1); line-height: 1.6; color: var(--muted); }
  .card-foot { display: flex; align-items: center; justify-content: space-between; gap: var(--s-2); margin-top: auto; padding-top: var(--s-3); border-top: 1px solid var(--line); }
  .more { display: inline-flex; align-items: center; gap: 6px; font-size: 0.85rem; font-weight: 600; color: var(--accent); }
  .more :global(svg) { transition: transform var(--dur) var(--ease); }
  .card:hover .more :global(svg) { transform: translateX(2px); }
  .mini-link {
    position: relative; z-index: 2; display: inline-flex; align-items: center; gap: 4px;
    font-size: 0.82rem; font-weight: 600; text-decoration: none; min-height: 36px; padding: 0 var(--s-3);
    border-radius: 999px; border: 1px solid var(--line); transition: border-color var(--dur-2) var(--ease-out), color var(--dur-1) var(--ease-out);
  }
  .mini-link:hover { border-color: var(--accent); }
  .card[hidden] { display: none; }
</style>
