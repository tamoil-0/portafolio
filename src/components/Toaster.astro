---
/**
 * Región global de avisos (toasts).
 * Uso desde cualquier script:
 *   window.dispatchEvent(new CustomEvent('app:toast', { detail: { message: '¡Correo copiado!', icon: 'check' } }))
 * `detail` también puede ser un string. Iconos: check, copy, mail, whatsapp, sun, moon, close, search, info (por defecto).
 * Es un popover manual para quedar por encima de los <dialog> modales (top layer).
 */
import Icon from './Icon.astro';
const icons = ['check', 'copy', 'mail', 'whatsapp', 'sun', 'moon', 'close', 'search'] as const;
---
<div class="toaster" popover="manual" data-toaster>
  <ol class="toaster-list" role="status" aria-live="polite" aria-label="Notificaciones" data-toaster-list></ol>
</div>
{icons.map((n) => <template data-toast-icon={n}><Icon name={n} size={15} /></template>)}
<template data-toast-icon="info"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg></template>

<style is:global>
  .toaster {
    position: fixed; inset: auto 0 max(20px, env(safe-area-inset-bottom)) 0; z-index: 90;
    width: min(440px, calc(100vw - 32px)); height: auto; margin: 0 auto; padding: 0; border: 0;
    background: transparent; color: var(--text); overflow: visible; pointer-events: none;
  }
  .toaster-list { display: flex; flex-direction: column; align-items: center; gap: 8px; list-style: none; margin: 0; padding: 0; }
  .toast {
    pointer-events: auto; display: inline-flex; align-items: center; gap: 10px; max-width: 100%;
    padding: 8px 16px 8px 8px; border-radius: 999px;
    font-family: var(--font-sans); font-size: var(--step--1); font-weight: 550; line-height: 1.35; letter-spacing: -0.005em;
    color: var(--text); background: color-mix(in srgb, var(--surface) 86%, transparent);
    border: 1px solid var(--line); box-shadow: var(--shadow-lg);
    backdrop-filter: saturate(180%) blur(18px); -webkit-backdrop-filter: saturate(180%) blur(18px);
    animation: toast-in 320ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .toast.is-leaving { animation: toast-out 220ms cubic-bezier(0.4, 0, 1, 1) both; }
  .toast-icon {
    flex: none; display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%;
    color: var(--accent); background: var(--accent-soft);
  }
  .toast-icon[data-kind='check'] { color: var(--ok); background: color-mix(in srgb, var(--ok) 14%, transparent); }
  .toast-icon[data-kind='whatsapp'] { color: #12a150; background: color-mix(in srgb, var(--wa) 16%, transparent); }
  .toast-icon svg { width: 15px; height: 15px; }
  .toast-msg { min-width: 0; overflow-wrap: anywhere; }
  @keyframes toast-in { from { opacity: 0; transform: translateY(14px) scale(0.96); filter: blur(2px); } }
  @keyframes toast-out { to { opacity: 0; transform: translateY(6px) scale(0.96); } }
  /* En móvil, por encima del botón flotante de WhatsApp */
  @media (max-width: 520px) {
    .toaster { bottom: calc(max(16px, env(safe-area-inset-bottom)) + 68px); }
  }
  .toaster.at-top { top: max(14px, env(safe-area-inset-top)); bottom: auto; }
  .toaster.at-top .toaster-list { flex-direction: column-reverse; }
  .toaster.at-top .toast { animation-name: toast-in-top; }
  .toaster.at-top .toast.is-leaving { animation-name: toast-out-top; }
  @keyframes toast-in-top { from { opacity: 0; transform: translateY(-14px) scale(0.96); filter: blur(2px); } }
  @keyframes toast-out-top { to { opacity: 0; transform: translateY(-6px) scale(0.96); } }
  @media (prefers-reduced-motion: reduce) {
    .toast, .toast.is-leaving { animation: none; }
  }
</style>

<script>
  type ToastDetail = string | { message?: string; icon?: string; duration?: number };
  const host = document.querySelector<HTMLElement>('[data-toaster]');
  const list = document.querySelector<HTMLOListElement>('[data-toaster-list]');
  const MAX = 3;
  const DURATION = 2600;

  if (host && list) {
    const supportsPopover = typeof host.showPopover === 'function';
    const ensureOnTop = () => {
      if (!supportsPopover) return;
      try {
        // Si hay un modal abierto, volver a mostrar el popover lo coloca encima en el top layer.
        if (host.matches(':popover-open') && document.querySelector('dialog[open]')) host.hidePopover();
        if (!host.matches(':popover-open')) host.showPopover();
      } catch {}
    };

    // Se muestra vacío desde el inicio para que la región aria-live ya exista al anunciar.
    ensureOnTop();

    const iconFor = (name: string) => {
      const tpl = document.querySelector<HTMLTemplateElement>(`template[data-toast-icon="${CSS.escape(name)}"]`)
        ?? document.querySelector<HTMLTemplateElement>('template[data-toast-icon="info"]');
      return tpl ? tpl.content.cloneNode(true) : null;
    };

    // Pausa al pasar el cursor por encima de la pila
    let paused = false;
    const timers = new Map<HTMLElement, { left: number; started: number; id?: number }>();
    const schedule = (el: HTMLElement) => {
      const t = timers.get(el);
      if (!t || paused) return;
      t.started = performance.now();
      t.id = window.setTimeout(() => dismiss(el), t.left);
    };
    const dismiss = (el: HTMLElement) => {
      const t = timers.get(el);
      if (t?.id) clearTimeout(t.id);
      timers.delete(el);
      if (el.classList.contains('is-leaving')) return;
      el.classList.add('is-leaving');
      const done = () => el.remove();
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return done();
      el.addEventListener('animationend', done, { once: true });
      setTimeout(done, 400);
    };
    list.addEventListener('pointerenter', () => {
      paused = true;
      timers.forEach((t) => { if (t.id) { clearTimeout(t.id); t.id = undefined; t.left -= performance.now() - t.started; } });
    });
    list.addEventListener('pointerleave', () => {
      paused = false;
      timers.forEach((_, el) => schedule(el));
    });

    addEventListener('app:toast', (e) => {
      const d = (e as CustomEvent<ToastDetail>).detail;
      const message = typeof d === 'string' ? d : d?.message;
      if (!message) return;
      const icon = (typeof d === 'object' && d?.icon) || 'info';
      const duration = (typeof d === 'object' && d?.duration) || DURATION;

      ensureOnTop();
      // Con una hoja inferior abierta en móvil, los avisos salen arriba para no tapar sus botones
      host.classList.toggle('at-top', Boolean(document.querySelector('dialog[open]')) && matchMedia('(max-width: 640px)').matches);
      const li = document.createElement('li');
      li.className = 'toast';
      const ic = document.createElement('span');
      ic.className = 'toast-icon';
      ic.dataset.kind = icon;
      const svg = iconFor(icon);
      if (svg) ic.append(svg);
      const msg = document.createElement('span');
      msg.className = 'toast-msg';
      msg.textContent = message;
      li.append(ic, msg);
      list.append(li);

      const active = [...list.children].filter((c) => !c.classList.contains('is-leaving')) as HTMLElement[];
      active.slice(0, Math.max(0, active.length - MAX)).forEach(dismiss);

      timers.set(li, { left: duration, started: performance.now() });
      schedule(li);
    });
  }
</script>
