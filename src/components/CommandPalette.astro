---
/**
 * Paleta de comandos (Ctrl/⌘ + K o cualquier [data-open-palette]).
 * También: window.dispatchEvent(new CustomEvent('app:palette')).
 * Los elementos [data-kbd-mod] muestran "⌘" en Mac y "Ctrl" en el resto.
 */
import Icon from './Icon.astro';
import { profile, projects, projectUrl, url, whatsappUrl, catClass } from '../lib/site';

const data = {
  email: profile.email,
  wa: whatsappUrl(),
  projects: projects.map((p) => ({
    t: p.title,
    h: projectUrl(p),
    c: p.category,
    k: catClass(p.category).split(' ').pop(),
    d: p.shortDescription,
    l: Boolean(p.liveUrl),
    x: [...p.tags, ...p.stack].join(' '),
  })),
  sections: [
    { t: 'Proyectos', h: url('#proyectos'), d: 'Proyectos destacados', x: 'destacados trabajos portafolio' },
    { t: 'Todos', h: url('#todos'), d: 'Todos los proyectos, con filtros', x: 'lista filtros categorias todos los proyectos' },
    { t: 'Trayectoria', h: url('#trayectoria'), d: 'Experiencia y formación', x: 'experiencia formacion educacion trabajo universidad cv' },
    { t: 'Sobre mí', h: url('#sobre-mi'), d: 'Perfil y forma de trabajar', x: 'perfil bio quien soy habilidades' },
    { t: 'Contacto', h: url('#contacto'), d: 'Formas de contacto', x: 'hablemos email correo whatsapp' },
  ],
};
const iconNames = ['search', 'whatsapp', 'mail', 'copy', 'sun', 'moon', 'arrowRight', 'external'] as const;
---
<dialog class="cp" data-palette aria-label="Buscar en el portafolio">
  <div class="cp-grip" data-grip><span class="cp-handle" aria-hidden="true"></span></div>
  <div class="cp-search">
    <span class="cp-search-icon" aria-hidden="true"><Icon name="search" size={19} /></span>
    <input
      class="cp-input"
      data-palette-input
      type="text"
      role="combobox"
      aria-expanded="true"
      aria-controls="cp-list"
      aria-autocomplete="list"
      aria-label="Buscar proyectos, secciones y acciones"
      placeholder="Buscar proyectos, secciones o acciones…"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      enterkeyhint="go"
    />
    <button class="cp-esc" type="button" data-close aria-label="Cerrar búsqueda">
      <kbd class="cp-esc-kbd">esc</kbd><span class="cp-esc-x"><Icon name="close" size={18} /></span>
    </button>
  </div>
  <div class="cp-list" id="cp-list" role="listbox" aria-label="Resultados" data-palette-list></div>
  <div class="cp-empty" data-palette-empty hidden>
    <span class="cp-empty-icon" aria-hidden="true"><Icon name="search" size={20} /></span>
    <p class="cp-empty-title">Sin resultados para <span data-palette-q></span></p>
    <p class="cp-empty-sub">Prueba con otra palabra, o <button type="button" class="cp-link" data-palette-contact>escríbeme directamente</button>.</p>
  </div>
  <footer class="cp-foot">
    <span class="cp-keys" aria-hidden="true">
      <span><kbd>↑</kbd><kbd>↓</kbd> navegar</span>
      <span><kbd>↵</kbd> abrir</span>
      <span><kbd>esc</kbd> cerrar</span>
    </span>
    <span class="cp-count" role="status" data-palette-count></span>
  </footer>
  <script type="application/json" data-palette-data set:html={JSON.stringify(data)} />
  {iconNames.map((n) => <template data-cp-icon={n}><Icon name={n} size={17} /></template>)}
  <template data-cp-icon="hash"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 9h15M4 15h15M10 3 8 21M16 3l-2 18"/></svg></template>
  <template data-cp-icon="form"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12Z"/><path d="M8.5 10.5h7M8.5 13.5h4.5"/></svg></template>
  <template data-cp-icon="enter"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 5v7a3 3 0 0 1-3 3H5"/><path d="m9 11-4 4 4 4"/></svg></template>
</dialog>

<style is:global>
  .cp {
    width: min(640px, 92vw); max-width: none; height: min(520px, calc(100dvh - 24vh)); max-height: none;
    margin: 14vh auto auto; padding: 0; overflow: hidden;
    color: var(--text); border: 1px solid var(--line); border-radius: 16px;
    background: var(--surface);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06), var(--shadow-lg);
  }
  .cp[open] { display: flex; flex-direction: column; animation: cp-in 220ms cubic-bezier(0.16, 1, 0.3, 1) both; }
  .cp.is-closing { animation: cp-out 140ms cubic-bezier(0.4, 0, 1, 1) both; }
  .cp::backdrop {
    background: rgb(10 10 16 / 0.35);
    backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
    animation: cp-fade 220ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .cp.is-closing::backdrop { animation: cp-fade 140ms cubic-bezier(0.4, 0, 1, 1) reverse both; }
  :root[data-theme='dark'] .cp::backdrop { background: rgb(10 10 16 / 0.6); }
  @media (prefers-color-scheme: dark) { :root:not([data-theme='light']) .cp::backdrop { background: rgb(10 10 16 / 0.6); } }
  @keyframes cp-in { from { opacity: 0; transform: translateY(6px) scale(0.97); } }
  @keyframes cp-out { to { opacity: 0; transform: translateY(4px) scale(0.98); } }
  @keyframes cp-fade { from { opacity: 0; } }

  .cp-grip { display: none; }
  .cp-search { flex: none; display: flex; align-items: center; gap: 12px; height: 62px; padding: 0 14px 0 20px; border-bottom: 1px solid var(--line); }
  .cp-search-icon { color: var(--faint); display: grid; }
  .cp-input {
    flex: 1; min-width: 0; height: 100%; padding: 0; border: 0; outline: 0; background: transparent;
    font: inherit; font-size: 1.05rem; color: var(--text); letter-spacing: -0.005em;
  }
  .cp-input::placeholder { color: var(--faint); }
  .cp-input:focus-visible { outline: none; }
  .cp-esc {
    flex: none; display: grid; place-items: center; min-width: 36px; height: 30px; padding: 0; border: 0; background: none; cursor: pointer; color: var(--muted); border-radius: 8px;
  }
  .cp-esc-x { display: none; }
  .cp kbd, .cp-esc-kbd {
    display: inline-grid; place-items: center; min-width: 20px; padding: 1px 6px; border-radius: 6px;
    font-family: var(--font-mono); font-size: 11px; font-weight: 500; line-height: 1.5; color: var(--muted);
    background: var(--surface-2); border: 1px solid var(--line-strong); border-bottom-width: 2px;
  }
  .cp-esc:hover kbd { color: var(--text); border-color: var(--line-strong); }

  .cp-list { flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior: contain; padding: 4px 8px 10px; scroll-padding-block: 36px 10px; scrollbar-width: thin; }
  .cp-group + .cp-group { margin-top: 4px; }
  .cp-group-label {
    position: sticky; top: -4px; z-index: 1; display: flex; justify-content: space-between; align-items: center;
    padding: 12px 12px 6px; font-family: var(--font-mono); font-size: 0.68rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--faint);
    background: linear-gradient(color-mix(in srgb, var(--surface) 96%, transparent) 70%, transparent);
  }
  .cp-item {
    position: relative; display: grid; grid-template-columns: 34px minmax(0, 1fr) auto; align-items: center; gap: 12px;
    min-height: 48px; padding: 8px 12px; border-radius: 14px; color: var(--text); text-decoration: none; cursor: pointer;
    transition: background 120ms ease;
  }
  .cp-item:hover { color: var(--text); }
  .cp-item[aria-selected='true'] { background: color-mix(in srgb, var(--accent) 10%, transparent); }
  .cp-item[aria-selected='true']::before {
    content: ''; position: absolute; left: 0; top: 12px; bottom: 12px; width: 3px; border-radius: 0 3px 3px 0; background: var(--accent);
  }
  .cp-tile {
    --c: var(--accent); display: grid; place-items: center; width: 34px; height: 34px; border-radius: 10px;
    color: var(--c); background: color-mix(in srgb, var(--c) 13%, transparent); border: 1px solid color-mix(in srgb, var(--c) 18%, transparent);
    font-family: var(--font-display); font-weight: 700; font-size: 0.95rem;
  }
  .cp-tile.is-plain { --c: var(--muted); background: var(--surface-2); border-color: var(--line); }
  .cp-tile.is-wa { --c: #12a150; }
  .cp-main { display: grid; gap: 1px; min-width: 0; }
  .cp-title-row { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .cp-title { font-weight: 600; font-size: 0.94rem; line-height: 1.35; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cp-title mark, .cp-desc mark { background: none; color: var(--accent); font-weight: 700; }
  .cp-pill.badge { flex: none; padding: 2px 8px; font-size: 0.68rem; gap: 5px; }
  .cp-pill.cat::before { width: 6px; height: 6px; }
  .cp-desc { font-size: 0.8rem; line-height: 1.4; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cp-meta { display: flex; align-items: center; gap: 10px; color: var(--faint); font-size: 0.74rem; }
  .cp-live { display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.02em; color: var(--muted); }
  .cp-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 0 3px color-mix(in srgb, var(--ok) 18%, transparent); }
  .cp-enter {
    display: grid; place-items: center; width: 26px; height: 26px; border-radius: 8px; color: var(--accent);
    background: var(--surface); border: 1px solid var(--line); opacity: 0; transform: translateX(-4px);
    transition: opacity 140ms ease, transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cp-item[aria-selected='true'] .cp-enter { opacity: 1; transform: none; }

  .cp-empty { flex: 1; display: grid; place-content: center; justify-items: center; gap: 6px; padding: 32px 24px; text-align: center; }
  .cp-empty[hidden] { display: none; }
  .cp-empty-icon { display: grid; place-items: center; width: 44px; height: 44px; margin-bottom: 8px; border-radius: 14px; color: var(--muted); background: var(--surface-2); border: 1px solid var(--line); }
  .cp-empty-title { font-weight: 600; }
  .cp-empty-title span { color: var(--accent); overflow-wrap: anywhere; }
  .cp-empty-sub { font-size: 0.86rem; color: var(--muted); }
  .cp-link { padding: 0; border: 0; background: none; font: inherit; color: var(--accent); cursor: pointer; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: color-mix(in srgb, currentColor 40%, transparent); }

  .cp-foot {
    flex: none; display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 44px; padding: 0 16px 0 20px;
    border-top: 1px solid var(--line); background: color-mix(in srgb, var(--surface-2) 60%, transparent);
    font-family: var(--font-mono); font-size: 0.7rem; color: var(--faint);
  }
  .cp-keys { display: flex; gap: 16px; }
  .cp-keys > span { display: inline-flex; align-items: center; gap: 6px; }
  .cp-keys kbd + kbd { margin-left: -3px; }

  @media (max-width: 640px) {
    .cp {
      width: 100%; height: min(86dvh, 680px); margin: auto 0 0;
      border-radius: 16px 16px 0 0; border-bottom: 0; padding-bottom: env(safe-area-inset-bottom);
    }
    .cp[open] { animation: cp-sheet-in 300ms cubic-bezier(0.16, 1, 0.3, 1) both; }
    .cp.is-closing { animation: cp-sheet-out 180ms cubic-bezier(0.4, 0, 1, 1) both; }
    .cp-grip { display: block; flex: none; padding: 10px 0 2px; touch-action: none; cursor: grab; }
    .cp-handle { display: block; width: 40px; height: 5px; margin: 0 auto; border-radius: 999px; background: var(--line-strong); }
    .cp-search { height: 56px; padding: 0 8px 0 16px; }
    .cp-input { font-size: 1rem; }
    .cp-esc-kbd { display: none !important; }
    .cp-esc-x { display: grid; }
    .cp-esc { width: 40px; height: 40px; border-radius: 999px; }
    .cp-list { padding-inline: 6px; }
    .cp-item { gap: 10px; padding: 8px 10px; }
    .cp-live-label, .cp-enter { display: none; }
    /* En móvil la categoría queda como punto de color (el texto sigue para lectores de pantalla) */
    .cp-pill.badge { padding: 0; font-size: 0; background: none; gap: 0; }
    .cp-group-label { padding-inline: 10px; }
    .cp-keys { display: none; }
    .cp-foot { justify-content: center; }
  }
  @keyframes cp-sheet-in { from { transform: translateY(100%); } }
  @keyframes cp-sheet-out { to { transform: translateY(100%); } }
  @media (prefers-reduced-motion: reduce) {
    .cp[open], .cp.is-closing, .cp::backdrop, .cp.is-closing::backdrop { animation: none; }
  }
</style>

<script>
  interface Raw {
    email: string; wa: string;
    projects: { t: string; h: string; c: string; k: string; d: string; l: boolean; x: string }[];
    sections: { t: string; h: string; d: string; x: string }[];
  }
  type Group = 'Proyectos' | 'Secciones' | 'Acciones';
  interface Item {
    group: Group; title: string; desc: string; hay: string; href?: string; external?: boolean;
    icon?: string; letter?: string; cat?: string; catKey?: string; live?: boolean; tile?: string;
    run?: () => void;
  }

  const dlg = document.querySelector<HTMLDialogElement>('[data-palette]');
  const dataEl = document.querySelector<HTMLScriptElement>('[data-palette-data]');

  // Atajo con la tecla correcta según el sistema
  const isMac = /Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent);
  if (isMac) document.querySelectorAll('[data-kbd-mod]').forEach((k) => { k.textContent = '⌘'; });

  if (dlg && dataEl) {
    const raw = JSON.parse(dataEl.textContent || '{}') as Raw;
    const html = document.documentElement;
    const input = dlg.querySelector<HTMLInputElement>('[data-palette-input]')!;
    const list = dlg.querySelector<HTMLElement>('[data-palette-list]')!;
    const empty = dlg.querySelector<HTMLElement>('[data-palette-empty]')!;
    const count = dlg.querySelector<HTMLElement>('[data-palette-count]')!;
    const reduce = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
    const toast = (message: string, icon?: string) => dispatchEvent(new CustomEvent('app:toast', { detail: { message, icon } }));
    const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
    const icon = (name: string) => {
      const t = dlg.querySelector<HTMLTemplateElement>(`template[data-cp-icon="${name}"]`);
      return t ? t.content.cloneNode(true) : document.createTextNode('');
    };

    // ---------- Tema (misma lógica que el menú) ----------
    const currentTheme = () => html.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const toggleTheme = () => {
      const next = currentTheme() === 'dark' ? 'light' : 'dark';
      html.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch {}
      toast(next === 'dark' ? 'Tema oscuro activado' : 'Tema claro activado', next === 'dark' ? 'moon' : 'sun');
    };

    const copyEmail = async () => {
      let ok = false;
      try { await navigator.clipboard.writeText(raw.email); ok = true; } catch {
        const ta = Object.assign(document.createElement('textarea'), { value: raw.email });
        ta.style.cssText = 'position:fixed;opacity:0;pointer-events:none';
        document.body.append(ta); ta.select();
        try { ok = document.execCommand('copy'); } catch {}
        ta.remove();
      }
      toast(ok ? '¡Correo copiado!' : `No se pudo copiar: ${raw.email}`, ok ? 'check' : 'mail');
    };

    // ---------- Datos ----------
    const buildItems = (): Item[] => {
      const dark = currentTheme() === 'dark';
      return [
        ...raw.projects.map<Item>((p) => ({
          group: 'Proyectos', title: p.t, desc: p.d, href: p.h, cat: p.c, catKey: p.k, live: p.l,
          letter: p.t.trim()[0]?.toUpperCase() ?? '·',
          hay: norm(`${p.t} ${p.c} ${p.d} ${p.x}`),
        })),
        ...raw.sections.map<Item>((s) => ({
          group: 'Secciones', title: s.t, desc: s.d, href: s.h, icon: 'hash', tile: 'is-plain', hay: norm(`${s.t} ${s.d} ${s.x} seccion ir`),
        })),
        { group: 'Acciones', title: 'Escribir por WhatsApp', desc: 'Chat directo', href: raw.wa, external: true, icon: 'whatsapp', tile: 'is-wa', hay: norm('escribir por whatsapp chat mensaje celular telefono hablemos') },
        { group: 'Acciones', title: 'Abrir formulario de contacto', desc: 'Nombre, motivo y mensaje', icon: 'form', hay: norm('abrir formulario de contacto escribir mensaje hablemos email correo'),
          run: () => close(() => dispatchEvent(new CustomEvent('app:contact'))) },
        { group: 'Acciones', title: 'Copiar correo', desc: raw.email, icon: 'copy', hay: norm(`copiar correo email mail ${raw.email}`),
          run: () => { copyEmail(); close(); } },
        { group: 'Acciones', title: dark ? 'Cambiar a tema claro' : 'Cambiar a tema oscuro', desc: 'Apariencia', icon: dark ? 'sun' : 'moon',
          hay: norm('cambiar tema claro oscuro dark light modo apariencia noche dia'),
          run: () => { toggleTheme(); render(true); } },
      ];
    };

    // ---------- Búsqueda ----------
    const score = (it: Item, words: string[]) => {
      if (!words.every((w) => it.hay.includes(w))) return -1;
      const t = norm(it.title);
      return words.reduce((s, w) => s + (t.startsWith(w) ? 100 : wordStart(t, w) ? 70 : t.includes(w) ? 45 : wordStart(it.hay, w) ? 15 : 5), 0);
    };
    const wordStart = (hay: string, w: string) => new RegExp(`(^|[^a-z0-9])${w.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}`).test(hay);
    const highlight = (text: string, words: string[]) => {
      const frag = document.createDocumentFragment();
      const chars = [...text].map((c) => norm(c));
      if (!words.length || chars.some((c) => c.length !== 1)) { frag.append(text); return frag; }
      const n = chars.join('');
      const marks = new Array<boolean>(chars.length).fill(false);
      words.forEach((w) => { let i = n.indexOf(w); while (i !== -1 && w) { for (let j = i; j < i + w.length; j++) marks[j] = true; i = n.indexOf(w, i + w.length); } });
      const src = [...text];
      let buf = '', on = false;
      const flush = () => { if (!buf) return; if (on) { const m = document.createElement('mark'); m.textContent = buf; frag.append(m); } else frag.append(buf); buf = ''; };
      src.forEach((c, i) => { if (marks[i] !== on) { flush(); on = marks[i]; } buf += c; });
      flush();
      return frag;
    };

    const EMPTY_PROJECTS = 4;
    const mobileMq = matchMedia('(max-width: 640px)');
    const setPlaceholder = () => { input.placeholder = mobileMq.matches ? 'Buscar en el portafolio…' : 'Buscar proyectos, secciones o acciones…'; };
    setPlaceholder();
    mobileMq.addEventListener?.('change', setPlaceholder);
    let items: Item[] = [];
    let shown: Item[] = [];
    let sel = 0;
    const optId = (i: number) => `cp-o-${i}`;

    const el = (tag: string, cls?: string, text?: string) => {
      const e = document.createElement(tag);
      if (cls) e.className = cls;
      if (text) e.textContent = text;
      return e;
    };

    const render = (keepSel = false) => {
      items = buildItems();
      const q = input.value.trim();
      const words = norm(q).split(/\s+/).filter(Boolean);
      const groups: Group[] = ['Proyectos', 'Secciones', 'Acciones'];
      shown = [];
      list.replaceChildren();
      const scored = groups.map((g) => {
        const found = items.filter((it) => it.group === g).map((it, i) => ({ it, i, s: score(it, words) })).filter((x) => x.s >= 0);
        if (words.length) found.sort((a, b) => b.s - a.s || a.i - b.i);
        return { g, found, best: found[0]?.s ?? -1 };
      });
      // Con búsqueda, el grupo con la mejor coincidencia va primero (orden estable si empatan)
      if (words.length) scored.sort((a, b) => b.best - a.best);
      scored.forEach(({ g, found }) => {
        let gi = found;
        if (!gi.length) return;
        const total = gi.length;
        // Sin búsqueda, solo unos pocos proyectos para que secciones y acciones queden a la vista
        if (!words.length && g === 'Proyectos') gi = gi.slice(0, EMPTY_PROJECTS);
        const box = el('div', 'cp-group');
        box.setAttribute('role', 'group');
        const lab = el('div', 'cp-group-label');
        lab.id = `cp-g-${g}`;
        lab.setAttribute('role', 'presentation');
        lab.append(el('span', '', g), el('span', '', gi.length < total ? `${gi.length} de ${total}` : String(total)));
        box.setAttribute('aria-labelledby', lab.id);
        box.append(lab);
        gi.forEach(({ it }) => {
          const idx = shown.push(it) - 1;
          const a = el(it.href ? 'a' : 'div', 'cp-item') as HTMLAnchorElement;
          a.id = optId(idx);
          a.setAttribute('role', 'option');
          a.setAttribute('aria-selected', 'false');
          a.tabIndex = -1;
          a.dataset.index = String(idx);
          if (it.href) { a.href = it.href; if (it.external) { a.target = '_blank'; a.rel = 'noopener'; } }
          const tile = el('span', `cp-tile ${it.catKey ?? ''} ${it.tile ?? ''}`.trim());
          tile.setAttribute('aria-hidden', 'true');
          if (it.letter) tile.textContent = it.letter; else if (it.icon) tile.append(icon(it.icon));
          const main = el('span', 'cp-main');
          const row = el('span', 'cp-title-row');
          const title = el('span', 'cp-title');
          title.append(highlight(it.title, words));
          row.append(title);
          if (it.cat) row.append(el('span', `badge cat ${it.catKey} cp-pill`, it.cat));
          const desc = el('span', 'cp-desc');
          desc.append(highlight(it.desc, words));
          main.append(row, desc);
          const meta = el('span', 'cp-meta');
          if (it.live) {
            const live = el('span', 'cp-live');
            live.title = 'Tiene versión pública en línea';
            live.append(el('span', 'cp-dot'), el('span', 'cp-live-label', 'En línea'));
            meta.append(live);
          }
          if (it.external) { const ex = el('span', 'cp-ext'); ex.setAttribute('aria-hidden', 'true'); ex.append(icon('external')); meta.append(ex); }
          const enter = el('span', 'cp-enter');
          enter.setAttribute('aria-hidden', 'true');
          enter.append(icon('enter'));
          meta.append(enter);
          a.append(tile, main, meta);
          box.append(a);
        });
        list.append(box);
      });
      empty.hidden = shown.length > 0;
      list.hidden = shown.length === 0;
      dlg.querySelector('[data-palette-q]')!.textContent = `“${q}”`;
      count.textContent = !words.length ? `${raw.projects.length} proyectos` : shown.length === 1 ? '1 resultado' : `${shown.length} resultados`;
      select(keepSel ? Math.min(sel, shown.length - 1) : 0, false);
      if (!keepSel) list.scrollTop = 0;
    };

    const select = (i: number, scroll = true) => {
      if (!shown.length) { input.removeAttribute('aria-activedescendant'); return; }
      sel = (i + shown.length) % shown.length;
      list.querySelectorAll('[aria-selected="true"]').forEach((o) => o.setAttribute('aria-selected', 'false'));
      const o = list.querySelector<HTMLElement>(`#${optId(sel)}`);
      o?.setAttribute('aria-selected', 'true');
      input.setAttribute('aria-activedescendant', optId(sel));
      if (scroll) o?.scrollIntoView({ block: 'nearest' });
    };

    const activate = (i: number, newTab = false) => {
      const it = shown[i];
      if (!it) return;
      if (it.run) return it.run();
      if (!it.href) return;
      if (it.external || newTab) { window.open(it.href, '_blank', 'noopener'); if (it.external) close(); return; }
      const href = it.href;
      close(() => { location.href = href; });
    };

    // ---------- Abrir / cerrar ----------
    const lock = () => {
      const sw = innerWidth - html.clientWidth;
      html.style.overflow = 'hidden';
      if (sw > 0) document.body.style.paddingRight = `${sw}px`;
    };
    const unlock = () => {
      if (document.querySelector('dialog[open]')) return;
      html.style.overflow = '';
      document.body.style.paddingRight = '';
    };
    let closing = false;
    let afterClose: (() => void) | null = null;
    const open = () => {
      if (dlg.open) return;
      closing = false;
      dlg.classList.remove('is-closing');
      dlg.style.transform = '';
      input.value = '';
      render();
      lock();
      dlg.showModal();
      input.focus();
    };
    function close(after?: () => void) {
      if (after) afterClose = after;
      if (!dlg!.open || closing) return;
      if (reduce()) { dlg!.close(); return; }
      closing = true;
      dlg!.classList.add('is-closing');
      const onEnd = (e: AnimationEvent) => { if (e.target === dlg && !e.pseudoElement) finish(); };
      const finish = () => {
        dlg!.removeEventListener('animationend', onEnd);
        if (!closing) return;
        closing = false;
        dlg!.classList.remove('is-closing');
        dlg!.close();
      };
      dlg!.addEventListener('animationend', onEnd);
      setTimeout(finish, 320);
    }
    dlg.addEventListener('close', () => {
      closing = false;
      dlg.classList.remove('is-closing');
      dlg.style.transform = '';
      dlg.style.transition = '';
      unlock();
      const fn = afterClose;
      afterClose = null;
      fn?.();
    });
    dlg.addEventListener('cancel', (e) => { e.preventDefault(); close(); });
    dlg.addEventListener('keydown', (e) => { if (e.key === 'Escape') { e.preventDefault(); close(); } });
    dlg.querySelector('[data-close]')?.addEventListener('click', () => close());
    dlg.querySelector('[data-palette-contact]')?.addEventListener('click', () => close(() => dispatchEvent(new CustomEvent('app:contact'))));
    dlg.addEventListener('click', (e) => {
      if (e.target !== dlg) return;
      const r = dlg.getBoundingClientRect();
      if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) close();
    });

    // ---------- Teclado y ratón ----------
    input.addEventListener('input', () => render());
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); select(sel + 1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); select(sel - 1); }
      else if (e.key === 'Enter' && !e.isComposing) { e.preventDefault(); activate(sel, e.ctrlKey || e.metaKey); }
    });
    list.addEventListener('pointermove', (e) => {
      const o = (e.target as Element).closest<HTMLElement>('.cp-item');
      if (o && Number(o.dataset.index) !== sel) select(Number(o.dataset.index), false);
    });
    list.addEventListener('click', (e) => {
      const o = (e.target as Element).closest<HTMLElement>('.cp-item');
      if (!o) return;
      const i = Number(o.dataset.index);
      const it = shown[i];
      const modified = e.ctrlKey || e.metaKey || e.shiftKey || e.button === 1;
      if (it?.external) { close(); return; } // el enlace abre la pestaña nueva por sí mismo
      if (it?.href && modified) return;
      e.preventDefault();
      activate(i);
      if (it?.run) input.focus();
    });

    // ---------- Arrastrar para cerrar (hoja inferior en móvil) ----------
    const grip = dlg.querySelector<HTMLElement>('[data-grip]');
    let startY = 0, dy = 0, dragging = false;
    grip?.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      dragging = true; startY = e.clientY; dy = 0;
      dlg.style.transition = 'none';
      grip.setPointerCapture(e.pointerId);
    });
    grip?.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      dy = Math.max(0, e.clientY - startY);
      dlg.style.transform = `translateY(${dy}px)`;
    });
    const endDrag = () => {
      if (!dragging) return;
      dragging = false;
      dlg.style.transition = 'transform 240ms cubic-bezier(0.16, 1, 0.3, 1)';
      if (dy > 90) { dlg.style.transform = 'translateY(100%)'; setTimeout(() => dlg.close(), 220); }
      else dlg.style.transform = '';
    };
    grip?.addEventListener('pointerup', endDrag);
    grip?.addEventListener('pointercancel', endDrag);

    // ---------- Disparadores ----------
    document.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && !e.altKey && !e.shiftKey && e.key.toLowerCase() === 'k') {
        const other = [...document.querySelectorAll('dialog[open]')].some((d) => d !== dlg);
        if (other) return;
        e.preventDefault();
        if (dlg.open) close(); else open();
      }
    });
    document.addEventListener('click', (e) => {
      const t = (e.target as Element | null)?.closest?.('[data-open-palette]');
      if (!t) return;
      e.preventDefault();
      open();
    });
    addEventListener('app:palette', open);
  }
</script>
