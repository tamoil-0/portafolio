---
import Icon from './Icon.astro';
import { whatsappUrl } from '../lib/site';
---
<a class="wa-fab" href={whatsappUrl()} target="_blank" rel="noopener" aria-label="Escríbeme por WhatsApp">
  <span class="wa-ring" aria-hidden="true"></span>
  <span class="wa-icon"><Icon name="whatsapp" size={28} /></span>
  <span class="wa-label">¿Hablamos?</span>
</a>

<style>
  .wa-fab {
    position: fixed; right: max(16px, env(safe-area-inset-right)); bottom: max(16px, env(safe-area-inset-bottom)); z-index: 70;
    display: inline-flex; align-items: center; height: 60px; padding: 0; border-radius: 999px;
    background: var(--wa); color: #fff; text-decoration: none; font-weight: 700; font-size: 0.95rem;
    box-shadow: 0 12px 30px -8px rgb(37 211 102 / 0.65), 0 2px 6px rgb(0 0 0 / 0.15);
    animation: wa-in 700ms var(--ease-spring) 900ms both;
    transition: transform var(--dur) var(--ease-spring), box-shadow var(--dur) var(--ease);
  }
  .wa-fab:hover { color: #fff; transform: translateY(-3px) scale(1.03); box-shadow: 0 18px 40px -10px rgb(37 211 102 / 0.8); }
  .wa-icon { display: grid; place-items: center; width: 60px; height: 60px; }
  .wa-label {
    max-width: 0; overflow: hidden; white-space: nowrap; opacity: 0;
    transition: max-width 400ms var(--ease), opacity 300ms var(--ease), padding 400ms var(--ease);
  }
  .wa-fab:hover .wa-label, .wa-fab:focus-visible .wa-label { max-width: 140px; opacity: 1; padding-right: 22px; }
  .wa-ring {
    position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
    box-shadow: 0 0 0 0 rgb(37 211 102 / 0.55); animation: wa-pulse 2.4s var(--ease) 2s infinite;
  }
  @keyframes wa-pulse { 70%, 100% { box-shadow: 0 0 0 18px rgb(37 211 102 / 0); } }
  @keyframes wa-in { from { opacity: 0; transform: translateY(30px) scale(0.6); } }
  @media (max-width: 520px) {
    .wa-fab { height: 54px; }
    .wa-icon { width: 54px; height: 54px; }
  }
  @media print { .wa-fab { display: none; } }
</style>
