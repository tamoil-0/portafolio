---
import Icon from './Icon.astro';
import { profile, url, whatsappUrl } from '../lib/site';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <p class="footer-name display">{profile.shortName}</p>
        <p class="muted">{profile.role} · {profile.location}</p>
      </div>
      <ul class="footer-links">
        <li><a href={whatsappUrl()} target="_blank" rel="noopener" aria-label="WhatsApp"><Icon name="whatsapp" size={18} /></a></li>
        <li><a href={profile.links.linkedin} rel="me noopener" target="_blank" aria-label="LinkedIn"><Icon name="linkedin" size={18} /></a></li>
        <li><a href={profile.links.github} rel="me noopener" target="_blank" aria-label="GitHub"><Icon name="github" size={18} /></a></li>
        <li><a href={`mailto:${profile.email}`} aria-label="Correo"><Icon name="mail" size={18} /></a></li>
      </ul>
    </div>
    <div class="footer-bottom muted">
      <p>© {year} {profile.name}</p>
      <a href={url('#main')} class="to-top">Volver arriba ↑</a>
    </div>
  </div>
</footer>

<style>
  .footer { position: relative; padding-block: var(--s-8) var(--s-6); font-size: var(--step--1); border-top: 1px solid var(--line); background: var(--bg-2); }
  .footer::before { content: ''; position: absolute; inset: -1px 0 auto; height: 1px; background: var(--grad); opacity: 0.6; }
  .footer-top { display: flex; align-items: center; justify-content: space-between; gap: var(--s-5); flex-wrap: wrap; }
  .footer-name { font-size: var(--step-2); }
  .footer-links { display: flex; gap: var(--s-2); list-style: none; }
  .footer-links a {
    display: grid; place-items: center; width: 46px; height: 46px; border-radius: 999px; color: var(--muted);
    border: 1px solid var(--line); background: var(--surface);
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease), transform var(--dur) var(--ease-spring);
  }
  .footer-links a:hover { color: var(--accent); border-color: var(--accent); transform: translateY(-3px); }
  .footer-bottom { display: flex; justify-content: space-between; gap: var(--s-4); flex-wrap: wrap; margin-top: var(--s-7); padding-top: var(--s-5); border-top: 1px solid var(--line); padding-right: 72px; }
  .to-top { text-decoration: none; }
</style>
