---
// Portada tipográfica de respaldo para proyectos que aún no tienen imágenes.
import type { Project } from '../lib/site';
interface Props { project: Project }
const { project } = Astro.props;
const id = `cv-${project.slug}`;
---
<svg viewBox="0 0 800 500" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby={`${id}-t`} class="cover">
  <title id={`${id}-t`}>{project.title}</title>
  <defs>
    <pattern id={`${id}-grid`} width="32" height="32" patternUnits="userSpaceOnUse">
      <path d="M32 0H0V32" fill="none" style="stroke: var(--line)" stroke-width="1" />
    </pattern>
  </defs>
  <rect width="800" height="500" style="fill: var(--surface-2)" />
  <rect width="800" height="500" fill={`url(#${id}-grid)`} opacity="0.7" />
  <text x="56" y="88" style="fill: var(--accent); font: 600 16px var(--font-sans); letter-spacing: .12em">
    {project.category.toUpperCase()}{project.isPrivate ? ' · PRIVADO' : ''}
  </text>
  <foreignObject x="56" y="120" width="688" height="300">
    <p xmlns="http://www.w3.org/1999/xhtml" style="margin:0; font: 400 58px/1.05 var(--font-serif); color: var(--text);">{project.title}</p>
  </foreignObject>
</svg>

<style>
  .cover { width: 100%; height: 100%; }
</style>
